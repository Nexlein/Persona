# ─── Supabase ───
SUPABASE_URL=CHANGE_ME_supabase_project_url
# Use the service_role key to bypass RLS for DB queries
SUPABASE_KEY=CHANGE_ME_supabase_service_role_key

# --- NEWS API ---
NEWS_API_KEY=CHANGE_ME_news_api_key

# ─── Mistral AI ───
MISTRAL_KEY=CHANGE_ME_mistral_api_key

# ─── N8N ───
# Encryption key for N8N credentials. NEVER change it
# after creating credentials or they will become unreadable.
# Generate it: `openssl rand -hex 32`
N8N_ENCRYPTION_KEY=CHANGE_ME_64_hex_characters

CREDENTIAL_MISTRAL_CLOUD_API_ID=personaMistral01
CREDENTIAL_SUPABASE_API_ID=personaSupabase1
CREDENTIAL_SMTP_ID=personaSMTPLocal

# ─── SMTP/Email Settings (Automated Setup) ───
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME_your_email@gmail.com
SMTP_PASSWORD=CHANGE_ME_your_app_password
SMTP_SECURE=true
